# Copy this file to .env (for local dev) and set the same variables in
# Netlify → Site settings → Environment variables (for production).

# Base URL of your deployed Railway backend.
# Do NOT include a trailing slash and do NOT include "/api" —
# the app appends "/api/..." itself.
VITE_API_URL=https://YOUR-RAILWAY-BACKEND.up.railway.app

# Optional — only needed if you use PayHere checkout.
VITE_PAYHERE_MERCHANT_ID=
VITE_PAYHERE_CURRENCY=LKR
